APP_NAME="Sistema de Películas"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
RELOAD=true
LOG_LEVEL="INFO"

# Entorno de la aplicación: development, testing, production
ENVIRONMENT="development"

# URL de la base de datos. Para SQLite, la ruta es relativa al directorio raíz.
DATABASE_URL="sqlite:///./peliculas.db"

SECRET_KEY="admin123"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"